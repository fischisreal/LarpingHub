local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")
local Stats = game:GetService("Stats")
local VirtualInputManager = game:GetService("VirtualInputManager")

local LocalPlayer = Players.LocalPlayer

getgenv().AntiVoid = true

local ENABLED = true
local STOPPED = false

local DEFAULT_DISTANCE = 5
local MIN_DISTANCE = 4
local LMB_DISTANCE = 2.5
local KEY_DISTANCE = 3.25
local CURRENT_DISTANCE = DEFAULT_DISTANCE

local BELOW_DISTANCE = 4
local MIN_BELOW_DISTANCE = 1
local MAX_BELOW_DISTANCE = 30
local CURRENT_BELOW_DISTANCE = BELOW_DISTANCE

