local keyFourHeld = false
local lmbHeld = false
local holdBackActive = false
local holdReleaseToken = 0
local lmbMissToken = 0

local velocityHistory = {}

local combatStickyUntil = 0

local cachedHeadTarget = nil
local cachedHead = nil

local killCount = 0
local lowHpCount = 0

